#!/bin/sh
# aquawm-session: login-manager entry point for AquaWM.
#
# Display managers (GDM, SDDM, LightDM, greetd) run the Exec line of
# /usr/share/wayland-sessions/aquawm.desktop, which points here. Using a
# wrapper instead of the binary keeps one file working for /usr/local,
# distro package, and nix profile installs alike: aquawm just needs to
# be on PATH.
#
# No arguments are expected; extra arguments (like a config path) still
# pass through to the compositor if a manager ever supplies them.

export XDG_CURRENT_DESKTOP=aquawm

# xkbcommon finds its keyboard description database via XKB_CONFIG_ROOT,
# falling back to a compiled-in path that does not exist on NixOS. When
# unset, point it at the system location if present; without this, keys
# silently stop translating into characters. No-op everywhere else.
if [ -z "$XKB_CONFIG_ROOT" ] && [ -d /run/current-system/sw/share/X11/xkb ]; then
    export XKB_CONFIG_ROOT=/run/current-system/sw/share/X11/xkb
fi

exec aquawm "$@"
